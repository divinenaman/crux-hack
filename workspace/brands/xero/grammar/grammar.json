  "techniques": [
    {
      "name": "Cropping inside frames",
      "applies_to": "blooms",
      "instruction": "Scale them beyond the edge of the frame to create movement and energy. Layer them to introduce colour and depth."
    },
    {
      "name": "Cropping that breaks the frame",
      "applies_to": "blooms",
      "instruction": "Blooms can also break the frame, adding depth and a stronger sense of motion."
    },
    {
      "name": "Patterning",
      "applies_to": "blooms",
      "instruction": "In the right context, blooms can pattern and be used as a textural background element. Limit it to a maximum of three colours, and ensure the blooms work cohesively in both form and orientation. Patterns shouldn't be applied arbitrarily or purely for decoration. They should only be used with clear intent, where they add meaning, support the message, or enhance the overall composition."
    },
    {
      "name": "Blooms in photography",
      "applies_to": "photography",
      "instruction": "In out-of-home, campaign, and top-of-funnel applications, crop photography into our blooms. Subjects can subtly break the mask to add depth."
    },
    {
      "name": "Crop blooms inside frames",
      "applies_to": "Blooms",
      "instruction": "Scale them beyond the edge of the frame to create movement and energy. Layer them to introduce colour and depth."
    },
    {
      "name": "Break the frame",
      "applies_to": "Blooms",
      "instruction": "Blooms can also break the frame, adding depth and a stronger sense of motion."
    },
    {
      "name": "Pattern limits",
      "applies_to": "Blooms",
      "instruction": "Limit it to a maximum of three colours, and ensure the blooms work cohesively in both form and orientation."
    },
    {
      "name": "Pattern intent",
      "applies_to": "Blooms",
      "instruction": "Patterns shouldn't be applied arbitrarily or purely for decoration. They should only be used with clear intent, where they add meaning, support the message, or enhance the overall composition."
    },
    {
      "name": "Photography masking",
      "applies_to": "Photography",
      "instruction": "In out-of-home, campaign, and top-of-funnel applications, crop photography into our blooms. Subjects can subtly break the mask to add depth."
    },
    {
      "name": "Pill for busy backgrounds",
      "applies_to": "Logo",
      "instruction": "When placing the Xero logo on busy backgrounds or over photography, use the pill. It makes the logo easy to spot and easy to read."
    },
    {
      "name": "Social avatar centering",
      "applies_to": "Logo",
      "instruction": "For social avatars, favicons and other small identifiers, centre the wordmark within a solid background. Be mindful that some platforms crop images into circles. Allow enough space to preserve legibility and visual balance."
    },
    {
      "name": "Partner logo sizing",
      "applies_to": "Partnerships",
      "instruction": "The partner logo should not exceed the visual size of the Xero wordmark. Where possible, align it to the same vertical height as the Xero wordmark."
    },
    {
      "name": "Partner prominence",
      "applies_to": "Partnerships",
      "instruction": "It's essential that third-party logos never appear visually larger than the Xero logo, ensuring our brand maintains appropriate prominence in all co-branded applications."
    },
    {
      "name": "Pill usage",
      "applies_to": "Logo",
      "instruction": "When placing the Xero logo on busy backgrounds or over photography, use the pill. It makes the logo easy to spot and easy to read."
    },
    {
      "name": "Partnership lockup",
      "applies_to": "Logo",
      "instruction": "When representing partnerships with app partners or third-party providers, use a '+' symbol between the Xero logo and the partner logo. The partner logo should not exceed the visual size of the Xero wordmark. Where possible, align it to the same vertical height as the Xero wordmark."
    }
  ],
  "context_rules": [
