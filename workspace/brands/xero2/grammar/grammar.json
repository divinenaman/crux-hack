  "techniques": [
    {
      "name": "Cropping inside frames",
      "applies_to": "Blooms",
      "instruction": "Scale them beyond the edge of the frame to create movement and energy. Layer them to introduce colour and depth."
    },
    {
      "name": "Cropping that breaks the frame",
      "applies_to": "Blooms",
      "instruction": "Blooms can also break the frame, adding depth and a stronger sense of motion."
    },
    {
      "name": "Patterning",
      "applies_to": "Blooms",
      "instruction": "In the right context, blooms can pattern and be used as a textural background element. Limit it to a maximum of three colours, and ensure the blooms work cohesively in both form and orientation."
    },
    {
      "name": "Blooms in photography",
      "applies_to": "Photography",
      "instruction": "In out-of-home, campaign, and top-of-funnel applications, crop photography into our blooms. Subjects can subtly break the mask to add depth."
    },
    {
      "name": "Pill usage",
      "applies_to": "Logo",
      "instruction": "When placing the Xero logo on busy backgrounds or over photography, use the pill. It makes the logo easy to spot and easy to read."
    }
  ],
