# Copy to backend/.env and fill in.
DEEPSEEK_PRO_KEY=
DEEPSEEK_FLASH_KEY=
OPENAI_IMAGE_KEY=
FAL_KEY=
IMAGE_BACKEND=fal
FAL_IMAGE_MODEL=fal-ai/bytedance/seedream/v5/lite/edit
FAL_T2I_MODEL=fal-ai/bytedance/seedream/v5/lite/text-to-image

